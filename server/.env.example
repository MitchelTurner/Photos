# Stripe — use test keys locally (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public site origin (success / cancel redirects)
SITE_URL=http://localhost:5500

# Postgres (Railway / local)
DATABASE_URL=postgresql://user:pass@localhost:5432/ketchikanphotos

# Prodigi Print API — sandbox: https://www.prodigi.com/print-api/docs/
PRODIGI_API_KEY=your_prodigi_api_key
# Use sandbox while testing; switch to https://api.prodigi.com/v4.0 for live
PRODIGI_API_BASE=https://api.sandbox.prodigi.com/v4.0
PRODIGI_SHIPPING_METHOD=Standard

# Absolute HTTPS URLs to print-ready assets, one per photo id.
# Pattern: {PRINT_ASSET_BASE_URL}/{photoId}.jpg  (e.g. …/assets/1.jpg)
# Leave unset to use PRODIGI_FALLBACK_ASSET_URL for every photo (sandbox only).
PRINT_ASSET_BASE_URL=
PRODIGI_FALLBACK_ASSET_URL=https://pwintytest.blob.core.windows.net/sample-media/QA/prodigi_landscape.jpg

# Comma-separated origins allowed to call POST /checkout (defaults to SITE_URL)
CORS_ORIGINS=

PORT=3000
